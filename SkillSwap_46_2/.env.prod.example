FRONTEND_URL=https://your-domain.example
VITE_API_URL=https://your-domain.example

PORT=3000
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=skillswap
# DB_SSL=true — только если БД требует SSL-подключения
DB_SSL=false
# DB_SYNC запрещён в production — схема обновляется только миграциями
DB_SYNC=false

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=604800

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=https://your-domain.example/api/auth/yandex/callback

MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="No Reply <noreply@example.com>"
